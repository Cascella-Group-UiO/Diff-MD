integrator               = md-vv
dt                       = 0.02
nsteps                   = 10000000

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000
nstenergy                = 1000
nstxout-compressed       = 1000
compressed-x-precision   = 100
compressed-x-grps        = System


cutoff-scheme            = Verlet
nstlist                  = 10
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = -1
r_list			 = 1.3

coulombtype              = reaction-field 
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1

tcoupl                   = v-rescale 
tc-grps                  = PMMA ETO
tau_t                    = 1.0 1.0
ref_t                    = 300 300
Pcoupl                   = berendsen  
Pcoupltype               = isotropic
tau_p                    = 4.0 
compressibility          = 3e-5
ref_p                    = 1.0 

gen_vel                  = no

constraints              = none 
refcoord_scaling	 = all
