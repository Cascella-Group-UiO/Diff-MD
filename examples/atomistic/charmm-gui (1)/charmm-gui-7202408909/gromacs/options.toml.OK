[simulation]
n_steps = 5000                    # Number of outer steps
n_print = 1                       # Number of steps after which the positions are saved
n_flush = 1                       # Number of prints after which the output file is saved
time_step = 0.0001                  # Inner loop timestep (for the fast forces)
respa_inner = 10                  # Number of inner loop steps. Therefore the timestep for the outer loop is given by (time_step * respa_inner)
cancel_com_momentum = true        # Whether to remove the center of mass momentum

start_temperature = false
target_temperature = 300.0
tau = 0.5
thermostat_coupling_groups = [
    ['N3', 'H', 'CX', 'HP', '2C', 'HC', 'C', 'O', 'N', 'H1', 'SH', 'HS', 'OH',
 'HO', 'C8', '3C', 'CT', 'CC', 'CR', 'H5', 'NB', 'CV', 'H4', 'CO', 'O2',
 'HA', 'N2', 'S', 'Zn2+', 'OW', 'HW'],
    ['NA', 'CA'],
]


#PRESSURE
pressure = false
barostat = "no"

coulombtype = "reaction-field"
dielectric_const = 1.0
epsilon_rf = 80
rv = 1.0
rc = 0.9
rlj = 0.9
ns_nlist = 2
nrexcl = 2

[atomistic_ff]
ff_family = "amber_like"
combining_rule = "pairtable"
coulomb14_scale = 0.8333333333
lj14_scale = 0.5
constrain_xh_bonds = false
ensemble = "NVT"

[field]
mesh_size = [20, 20, 20]          # FFT mesh grid. Only use even numbers with Diff-HyMD!
kappa = 0.05                      # Compressibilty
sigma = 0.5                       # Particle spread
rho0 = 8.86                       # Particle 'volume'. Optimized value for NPT
a = 9.21                          # Free parameter to fit water density. Optimized value for NPT
LJ_param = [
    ["C", "C", 0.34, 0.45],
    ["C", "N", 0.33, 0.40],
    ["C", "O", 0.32, 0.42],
    ["C", "H", 0.25, 0.10],
    ["N", "N", 0.32, 0.35],
    ["N", "O", 0.31, 0.38],
    ["N", "H", 0.24, 0.08],
    ["O", "O", 0.30, 0.30],
    ["O", "H", 0.23, 0.07],
    ["H", "H", 0.20, 0.02],
]




























































































































































































































